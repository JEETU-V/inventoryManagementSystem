FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=generate-a-random-secret-at-least-32-characters
JWT_SECRET_KEY=generate-a-different-random-secret-at-least-32-characters
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/inventory_management
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_ADMIN_EMAIL=platform-admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-unique-strong-password
PLATFORM_ADMIN_EMAILS=platform-admin@example.com

# Invoice / bill settings
COMPANY_NAME=Stockroom
COMPANY_ADDRESS=123 Main Street, Your City
COMPANY_PHONE=+91 9876543210
COMPANY_EMAIL=shop@example.com
COMPANY_GST_NUMBER=22AAAAA0000A1Z5
GST_RATE=0.18
